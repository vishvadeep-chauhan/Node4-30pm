<!DOCTYPE html>
<html>
<head>
  <title>User List</title>
</head>
<body>

  <h1>User List</h1>

  <form action="/add" method="POST">

    <input
      type="text"
      name="name"
      placeholder="Enter Name"
      required
    >

    <input
      type="number"
      name="age"
      placeholder="Enter Age"
      required
    >

    <input type="submit" value="Submit">

  </form>

  <ul>

    <% users.forEach(user => { %>

      <li>
        <%= user.name %> ,
        <%= user.age %>
      </li>

    <% }) %>

  </ul>

</body>
</html>